---
interface Props {
  variant: "sidebar" | "contact";
}

const { variant } = Astro.props;
const className = variant === "contact" ? "contact-methods" : "profile-socials";
---

<div class={className} role="group" aria-label="Social links">
  <a class="social-link" href="mailto:rahul42rathod@gmail.com" aria-label="Email Rahul Rathod" title="Email">
    <span class="social-icon" aria-hidden="true">
      <svg class="icon-mail" viewBox="0 0 24 24"><rect x="3.5" y="5.5" width="17" height="13" rx="2" /><path d="m4.5 7 7.5 6 7.5-6" /></svg>
    </span>
    <span class="social-label">Email</span>
  </a>
  <a class="social-link" href="https://github.com/rahulprojectcoding-commits" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile" title="GitHub">
