---
import Layout from "../layouts/Layout.astro";
import SocialLinks from "../components/SocialLinks.astro";
---

<Layout title="Contact" description="Contact Rahul Rathod about practical software products, backend engineering, and AI applications." activeRoute="/contact">
  <header class="page-section page-intro">
    <div class="content-wrap">
      <div class="contact-panel">
        <h1>Let's connect.</h1>
        <p>Have an interesting idea or want to discuss something? Feel free to reach out.</p>
        <SocialLinks variant="contact" />
      </div>
    </div>
  </header>
</Layout>
